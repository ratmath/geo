{
  "name": "@ratmath/geo",
  "version": "0.4.0",
  "description": "Geometry for RatMath: Euclidean constructions, theorems checked on exact figures and proved in general, spherical, hyperbolic, projective and finite geometries, symmetry and tilings",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test --timeout 60000 ./tests",
    "docs:build": "bun scripts/build-docs.js && node scripts/build-llms.mjs",
    "docs:llms": "node scripts/build-llms.mjs"
  },
  "keywords": [
    "geometry",
    "euclidean",
    "hyperbolic",
    "projective",
    "symmetry",
    "tiling",
    "exact",
    "ratmath",
    "theorem-proving",
    "wu-method",
    "groebner-basis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/geo.git"
  },
  "homepage": "https://ratmath.com/geo/",
  "bugs": {
    "url": "https://github.com/ratmath/geo/issues"
  },
  "dependencies": {
    "@ratmath/algebraic": "^0.1.0",
    "@ratmath/analytic": "^0.1.0",
    "@ratmath/graphics": "^0.1.0",
    "@ratmath/structures": "^0.5.0"
  },
  "peerDependencies": {
    "@ratmath/core": ">=0.10.0 <0.12.0"
  },
  "devDependencies": {
    "@ratmath/core": "^0.11.0",
    "katex": "0.19.1"
  },
  "types": "index.d.ts",
  "author": "James Taylor",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "vendor/algebraic",
    "vendor/analytic",
    "vendor/graphics",
    "vendor/structures",
    "vendor/linalg"
  ]
}
